APP_NAME="Crystal Movers"
# Local development. For production see docs/DEPLOYMENT.md (APP_ENV=production, APP_DEBUG=false, https APP_URL).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- PostgreSQL (Phase 1 uses PostgreSQL only) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=crystal_movers
DB_USERNAME=crystal_movers
DB_PASSWORD=

# --- Sessions / cache / queue (kept deliberately simple) ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set to true in production (https only).
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Behind a reverse proxy / tunnel / Railway: "*" (or the proxy IPs) so https and the real client IP are detected. Leave empty locally.
TRUSTED_PROXIES=

# --- Sanctum SPA auth for the admin area (comma-separated hosts, no scheme) ---
SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:5173,127.0.0.1:8000

# --- Email (Laravel Mail over SMTP; swap provider by changing these only) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Use an address on a domain you control and have verified with your mail provider. Do not invent one.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where "new quote request" / "new contact message" notifications are sent
ADMIN_NOTIFICATION_EMAIL=

# --- First admin account, created by `php artisan db:seed` ---
# The seeder skips the admin user if these are empty OR the password is weak (min 12 characters, not a common password).
# Never commit real values. Use a long, unique password and remove it from .env once the account exists.
ADMIN_NAME="Crystal Movers Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Optional: real company details used ONLY when the database is first seeded (otherwise set them in Admin > Settings)
COMPANY_PHONE=
COMPANY_WHATSAPP=
COMPANY_EMAIL=
