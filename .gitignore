/.phpunit.cache
/bootstrap/ssr
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
.idea
.vscode
.DS_Store
/dist-preview

# --- Secrets and local environment ---
.env.*
!.env.example

# --- Runtime data that must never be committed (customer data, uploads, logs, caches) ---
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/testing
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/bootstrap/cache/*.php
*.sql
*.dump

# --- Generated at build/deploy time (php artisan site:prerender); never edit by hand ---
/storage/app/site-data.json
/storage/app/prerender/*
!/storage/app/prerender/.gitignore

